# Copy to .env — .env is gitignored

# GCP / Vertex AI — required for all LLM and embedding calls
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
GCP_PROJECT_ID=analytics-prod-123
GCP_REGION=us-central1

# Gemini model on Vertex AI (chat/completion)
# Options: gemini-2.0-flash | gemini-2.5-flash | gemini-2.5-pro
VERTEX_MODEL=gemini-2.0-flash
